APP_NAME=itsm-design-agent
LOG_LEVEL=INFO
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:${POSTGRES_PORT}/app
# 문서·실행 API는 PostgreSQL을 권장합니다.
STORAGE_ROOT=.storage
VALIDATION_DATABASE_URL=

#--- Claude LLM -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=8192
ENABLE_PROMPT_CACHING=true

# 새 문서/실행 API 사용 시 true: 마이그레이션 및 중단 실행 정리
INITIALIZE_DATABASE=false
ANTHROPIC_TIMEOUT_SECONDS=120
# 두 키가 모두 있어야 추적 활성화. EU 기본값; US/자체 호스팅은 URL 변경
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
