# TEAM4_AGENT 폴더에서 복사해서 .env 로 사용: cp .env.example .env
# 서버·CLI·alembic(backend/app/core/config.py)과 docker compose가 같이 읽는다

# --- docker PostgreSQL (compose.yaml이 이 파일을 읽어 db 컨테이너를 만든다) ---
# 사용자·비밀번호는 DB 볼륨을 처음 만들 때만 적용된다 (바꾸려면 docker compose down -v 후 다시 만들기)
# 바꾸면 아래 DATABASE_URL·VALIDATION_DB_URL도 같은 값으로 맞춘다
POSTGRES_USER=reqagent
POSTGRES_PASSWORD=reqagent
POSTGRES_DB=reqagent
POSTGRES_PORT=55432

# --- LLM ---
# auto: ANTHROPIC_API_KEY가 있으면 anthropic, 아니면 OPENAI_API_KEY가 있으면 openai
# manual: 요청을 LLM_EXCHANGE_DIR에 파일로 쓰고, 작성된 응답 파일을 읽음 (API 없이 개발·재생)
LLM_PROVIDER=auto
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# gpt-5 계열/o 계열에만 적용 (none|low|medium|high). 비워두면 미적용
OPENAI_REASONING_EFFORT=low
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# 동시 LLM 호출 수, 배치 크기
LLM_CONCURRENCY=4
REQ_BATCH_SIZE=3
FUNC_GROUP_SIZE=12
ATTR_BATCH_SIZE=5
# 기능 명세: 전체 설계 전에 공통 결정(업무 객체 이름·분류값·공통 규칙)을 먼저 정함
FUNC_COMMON_DECISIONS=true
# 기능 명세 그룹 요청의 생각 수준 (비우면 ANTHROPIC_EFFORT). Haiku 실측 medium: 출력 −37%, 품질 지표 유지
FUNC_EFFORT=
# 기능 명세 '(가정)' 규칙 한도 (전체 업무 규칙 대비). 넘는 만큼 고객 확인 질문으로 정하고, 묻지 않은 '(확인 필요)'는 한도 안에서만
# 추천안 '(가정)'으로 바꾼다 (넘으면 '(확인 필요)'로 남김). 1이면 묻지 않고 모두 '(가정)'
FUNC_ASSUMPTION_LIMIT=0.1
# 기능 명세 확인 질문 상한. 한도를 맞추려면 더 물어야 해도 이만큼만 묻고, 덮지 못한 것은 '(확인 필요) 추천안'으로 남겨 화면에서 확인
FUNC_MAX_QUESTIONS=12

# --- 실행 한도 ---
MAX_STEPS=40
# 자동 수정·재시도 횟수. 단계별 값을 비우거나 0이면 MAX_FIX_ATTEMPTS를 쓴다
MAX_FIX_ATTEMPTS=2
# 기능 명세: 기능이 연결 안 된(누락) 요구사항 재설계·실패 재시도
FUNC_FIX_ATTEMPTS=1
# 데이터 설계(ERD): 모델 검증 오류 수정·연결 보완·실패 재시도
MODEL_FIX_ATTEMPTS=1
# DB 검증(DDL 적용) 실패 후 다시 고치기
MAX_DB_ATTEMPTS=1

# --- 입력·출력 (상대 경로는 backend/ 폴더 기준) ---
DATA_DIR=data
OUTPUT_DIR=output
LLM_EXCHANGE_DIR=output/llm_exchange

# --- 서비스 DB (PostgreSQL, docker compose up -d db) ---
# 사용자·비밀번호·포트·DB 이름은 위 POSTGRES_* 값과 같게
# 산출물·버전 기록·제목·작업 기록·실행 체크포인트를 저장한다. 비우면 OUTPUT_DIR 폴더 + SQLite 체크포인트 (로컬·테스트용)
# 처음 한 번: alembic upgrade head (테이블 만들기) → python -m app import-output (기존 output 폴더 가져오기)
DATABASE_URL=postgresql://reqagent:reqagent@localhost:55432/reqagent

# --- DB 검증 (run --validate-db) ---
# 비우면 기본 PostgreSQL: postgresql://reqagent:reqagent@localhost:55432/reqagent_validation
#   (서비스 DB와 같은 db 컨테이너 안의 검증 전용 DB. 접속할 수 없으면 SQLite로 대체 검증하고 보고서에 표시)
# sqlite 로 쓰면 처음부터 SQLite로만 검증 (PostgreSQL 전용 문법은 검증 안 됨)
VALIDATION_DB_URL=
KEEP_VALIDATION_SCHEMA=false

# --- 의미 검토 Agent (LLM이 요구사항 분류·모순, 기능 명세, 데이터 모델을 검토해 보고만 함) ---
# false 면 끔 (run --no-semantic-review 와 같음)
SEMANTIC_REVIEW=true
# final: 'ERD 최종 확정' 때만 한 번 (화면 버튼 → review) / auto: 산출물이 바뀔 때마다 / off: 안 함
SEMANTIC_REVIEW_MODE=final
# 의미 검토 실패 시 시도 횟수
SEMANTIC_REVIEW_ATTEMPTS=1
# true면 최종 확정 검토에서 기능 명세 ↔ 요구사항(원문)도 본다 (토큰 더 씀). 기본은 ERD ↔ 기능 명세만
SEMANTIC_REVIEW_SOURCE=false
# 요구사항 검토 Agent(원문 대조: 빠진 요구사항 보충·분류 확인·원문 외 추가 표시, 요구사항 충돌)와 요청 1건의 원문 단위 수
REQUIREMENT_REVIEW=true
REQ_REVIEW_BATCH=12
# 원문 문장이 요구사항에 담겼다고 보는 겹침 비율 (낮은 문장만 누락 검사로 보냄)과 검토 요청의 생각 수준 (빈 값이면 ANTHROPIC_EFFORT)
REQ_REVIEW_COVERAGE=0.6
REQ_REVIEW_EFFORT=low

# --- API 설계 Agent (개발 스펙: API.md·openapi.yaml·ARCHITECTURE.md 등 9개) ---
# 'ERD 최종 확정'(최종본 v<ERD>.1) 때만 돈다. 업로드·ERD 만들기 단계의 LLM 호출은 그대로
# false 면 끔. 요청 1건에 넣는 기능 수, 생각 수준 (빈 값이면 ANTHROPIC_EFFORT)
API_DESIGN=true
# API 검사 오류(없는 컬럼·API 없는 기능)를 그 기능만 다시 설계하는 횟수
API_FIX_ATTEMPTS=1
API_BATCH_SIZE=6
API_EFFORT=

# --- API 서버 ---
LOG_LEVEL=INFO
# 프론트를 다른 주소에서 띄울 때 허용할 출처 (쉼표로 구분). 로컬 Vite 개발 서버(5173)는 기본 허용
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
